{
 "uid": "reoagms-ops",
 "title": "REOAGMS Platform Health",
 "tags": [
  "reoagms"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Services up",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(up == 1)",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Services down",
   "type": "stat",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(up == 0) or vector(0)",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "title": "HTTP requests / sec",
   "type": "stat",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "Request rate by service",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "Avg response time (s)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (application) (rate(http_server_requests_seconds_sum[1m])) / sum by (application) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "JVM heap used",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "title": "CPU usage",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "process_cpu_usage",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  }
 ]
}